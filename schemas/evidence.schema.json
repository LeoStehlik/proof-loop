{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Loop Evidence",
  "type": "object",
  "required": [
    "task_id",
    "checks"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "command",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "raw_log": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "raw_logs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
