{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proof Loop Verdict",
  "type": "object",
  "required": [
    "task_id",
    "phase",
    "agent",
    "timestamp",
    "overall",
    "criteria"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "overall": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[1-9][0-9]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
